# Chuỗi kết nối PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booking_management"
# Số kết nối tối đa trong pool (mặc định 10)
DATABASE_POOL_MAX=10

# Bí mật ký JWT — BẮT BUỘC khi chạy production, tối thiểu 32 ký tự.
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# development | production (production: bật cookie secure, ẩn log OTP, bắt buộc JWT_SECRET)
NODE_ENV=development
PORT=3000
